[Unit]
Description=WoW level-up Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/wow-level-bot
ExecStart=/usr/bin/node --env-file=.env dist/index.js
Restart=always
RestartSec=10
# Keep memory in check on the Pi 3's 1 GB of RAM
Environment=NODE_OPTIONS=--max-old-space-size=256

[Install]
WantedBy=multi-user.target
