# Discord: https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Optional: a server ID to register slash commands to instantly while testing.
# Leave empty to register globally (all servers the bot is in).
DEV_GUILD_ID=

# Blizzard: https://develop.battle.net/access/clients -> Create Client
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Default region for /wow track when the user doesn't pick one (us, eu, kr, tw)
BLIZZARD_REGION=us
# Profile namespace for the game version you want to track, without the region suffix.
#   profile-classic1x  -> Classic Era / Hardcore / Anniversary-style era realms
#   profile-classic    -> Classic progression realms
#   profile            -> Retail
# Swap this to the WoW Forever namespace once Blizzard publishes it.
BLIZZARD_NAMESPACE=profile-classic1x
BLIZZARD_LOCALE=en_US
# Used when a player doesn't give a realm (handy for realm-less game modes).
DEFAULT_REALM=

# How often to check every tracked character, in minutes
POLL_INTERVAL_MINUTES=5
# Level that gets the extra-loud "max level" announcement
MAX_LEVEL=60
# Max characters a single Discord user can track per server
MAX_CHARACTERS_PER_USER=10
# Where tracked characters are saved
DATA_FILE=./data/state.json
